# Copy to .env.local (gitignored) for `npm -w @cm/sample run dev`. Placeholders only.
SAMPLE_RUN_SERVICE_URL=http://localhost:3000
SAMPLE_RUN_TOKEN_SECRET=replace-with-a-run-token-secret
SAMPLE_ISSUER=sample-app
SAMPLE_USER=sample-user
SAMPLE_TEAM=
# admin lets this dev server create agents (local developer only; a real host never mints it for a browser).
SAMPLE_ROLE=
SAMPLE_TENANT=sample-tenant
SAMPLE_TOKEN_TTL_S=120
# Optional: the manager's public viewing listener (CM_PUBLIC_BIND). Proxied at /view.
SAMPLE_VIEWER_BASE_URL=
VITE_VIEWER_TRANSPORT=auto
